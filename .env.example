# Fase 4B - Gateway local Supabase-compativel (APENAS DESENVOLVIMENTO LOCAL)
# Copie para .env e ajuste se necessario.
# NUNCA versionar o .env real. No Supabase Cloud/Vercel use apenas:
#   VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY (chave publica/publishable).

# URL do gateway local (dev) - em producao use https://SEU_PROJETO.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Endpoint usado pelo frontend (dev local)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Chave publica anon (dev local - valor ficticio, nao e segredo)
VITE_SUPABASE_ANON_KEY=TROQUE_POR_SUA_CHAVE_ANON_LOCAL

# Secret usado para assinar os JWTs de acesso local (dev - ficticio)
JWT_SECRET=TROQUE_POR_SEU_JWT_SECRET_LOCAL

# Service role key (dev local - NAO usar em VITE_*)
SUPABASE_SERVICE_ROLE_KEY=TROQUE_POR_SUA_SERVICE_ROLE_LOCAL

# Usuarios seed (dev local - credenciais ficticias)
SEED_USER_PESSOAL_EMAIL=TROQUE_POR_EMAIL_SEED_PESSOAL
SEED_USER_PESSOAL_PASSWORD=TROQUE_POR_SENHA_SEED_PESSOAL
SEED_USER_NEGOCIO_EMAIL=TROQUE_POR_EMAIL_SEED_NEGOCIO
SEED_USER_NEGOCIO_PASSWORD=TROQUE_POR_SENHA_SEED_NEGOCIO

# Pasta de dados do pglite local (disco) - vazio = apenas memoria
PGLITE_DATA_DIR=./.pglite-data
